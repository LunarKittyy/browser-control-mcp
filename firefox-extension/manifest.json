{
  "manifest_version": 2,
  "name": "Browser Control MCP",
  "version": "2.0.0",
  "description": "Lets a local MCP server (an AI agent) work in your browser alongside you, within an access policy you control.",
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "139.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "history",
    "storage",
    "activeTab",
    "contextualIdentities"
  ],
  "optional_permissions": [
    "<all_urls>",
    "*://*/*",
    "find",
    "bookmarks"
  ],
  "background": {
    "scripts": [
      "dist/background.js"
    ]
  },
  "browser_action": {
    "default_icon": "assets/icon.svg",
    "default_title": "Browser Control MCP",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume agent access"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
