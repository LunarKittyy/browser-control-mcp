{
  "name": "firefox-extension",
  "version": "2.0.0",
  "main": "dist/background.js",
  "scripts": {
    "build": "esbuild background.ts options.ts popup.ts --bundle --target=firefox126 --outdir=dist",
    "typecheck": "tsc --noEmit",
